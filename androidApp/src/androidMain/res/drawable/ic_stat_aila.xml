<?xml version="1.0" encoding="utf-8"?>
<!--
    Icona piccola delle notifiche (barra di stato). Android la usa come maschera: conta solo il
    canale alpha, il colore viene ignorato e sostituito dal sistema, quindi va disegnata in un solo
    colore pieno (qui bianco) e senza sfondo. Stesso marchio di ic_launcher_monochrome.xml, ma
    ritagliato: quello e' su una tela adattiva da 108dp con ampi margini di sicurezza, e a 24dp
    il marchio sarebbe rimasto minuscolo. Il gruppo sposta il marchio al centro di una tela 72x72.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="72"
    android:viewportHeight="72">
    <group
        android:translateX="-18"
        android:translateY="-18">
        <path
            android:pathData="M34.53,77.43 L48.39,37.83 Q54,24.63 59.61,37.83 L73.47,77.43"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="10.23"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />
        <path
            android:pathData="M54,55.782 C57.208,55.782 59.808,58.382 59.808,61.59 C59.808,64.798 57.208,67.398 54,67.398 C50.792,67.398 48.192,64.798 48.192,61.59 C48.192,58.382 50.792,55.782 54,55.782 Z"
            android:fillColor="#FFFFFFFF" />
    </group>
</vector>
