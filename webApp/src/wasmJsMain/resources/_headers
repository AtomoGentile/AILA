# Header di Cloudflare Pages.
# CSP: niente script inline né eval; rete solo verso il Worker di AILA e Google AI Studio.
# 'wasm-unsafe-eval' serve a compilare i .wasm dell'app (senza, Chrome e Safari rifiutano
# WebAssembly.instantiate con script-src 'self') e NON abilita eval() del JavaScript.
# worker-src: il service worker /sw.js e il worker di pdf.js (stessa origine). blob: per il ripiego di pdf.js.
# style-src 'unsafe-inline': Compose imposta gli stili degli elementi che crea (canvas, campi di testo).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://circolare-plus-worker.circolareclass.workers.dev https://generativelanguage.googleapis.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY

# Shell senza hash nel nome: sempre ricontrollata (304 se non e' cambiata), altrimenti dopo un
# rilascio la cache HTTP del browser terrebbe la versione vecchia. aila.js nomina i .wasm con
# hash: se restasse vecchia, punterebbe a file non piu' pubblicati.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/aila.js
  Cache-Control: no-cache

/styles.css
  Cache-Control: no-cache

# Il service worker va sempre ricontrollato, altrimenti gli aggiornamenti tardano.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

# I .wasm hanno l'hash del contenuto nel nome (webpack): non cambiano mai.
/*.wasm
  Cache-Control: public, max-age=31536000, immutable
