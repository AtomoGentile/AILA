<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- ML Kit GenAI (Gemini Nano via AICore) puo' chiedere un minSdk piu' alto di quello
         dell'app, che parte da 26 (Gemma/Phi via LiteRT-LM girano anche su Android 8-11). Senza
         override il manifest merger rifiuterebbe la build. E' sicuro perche' AiCoreEngine esce
         subito sotto API 31, prima di toccare qualunque classe di ML Kit: sui telefoni piu'
         vecchi il tier AICore resta semplicemente "non disponibile". -->
    <uses-sdk tools:overrideLibrary="com.google.mlkit.genai.prompt,com.google.mlkit.genai.common" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Il download del modello di AI locale e la sincronizzazione delle circolari girano ora in
         WorkManager con notifica in primo piano, cosi' sopravvivono a schermo spento o app in
         background invece di fermarsi appena si esce dalla schermata che li ha avviati (vedi
         circolareplus.work.LocalModelDownloadWorker / CircularsSyncWorker). Da Android 14 (API 34)
         un servizio in primo piano deve dichiarare il proprio tipo. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- allowBackup false: nelle preferenze ci sono il token di accesso e la chiave Gemini
         personale, che non devono finire nei backup di Google Drive ne' essere estratti con adb.
         dataExtractionRules copre anche il trasferimento fra telefoni (Android 12+). -->
    <application
        android:name=".CircolarePlusApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="AILA"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- Valori di riserva per le notifiche che FCM mostra da solo, senza passare da
             CircolareMessagingService (payload con blocco "notification"): senza, FCM usa
             l'icona del launcher, che in barra di stato diventa un quadrato bianco, e un canale
             generico. Il canale e' creato all'avvio da ensureNotificationChannel. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_aila" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="aila_notifications" />

        <!-- Accelerazione GPU dell'AI locale. Da Android 12 le librerie native di sistema vanno
             dichiarate esplicitamente: senza queste righe il motore non trova OpenCL e ricade
             sulla CPU, che per un modello da qualche miliardo di parametri significa attese di
             minuti invece che di secondi. required="false" perche' su un telefono senza driver
             OpenCL l'app deve comunque installarsi e funzionare (LocalLlm ricade su CPU). -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libOpenCL-car.so" android:required="false" />
        <uses-native-library android:name="libOpenCL-pixel.so" android:required="false" />
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <!-- configChanges: ruotando un tablet o ridimensionando la finestra (multi-finestra) l'app
             non viene ricreata: Compose si ridisegna da se' e tab, circolare aperta e sessione
             restano dove sono. Prima ogni rotazione ripartiva da zero. -->
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.App.Starting"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Senza questo servizio i push arrivavano solo a schermo chiuso (comportamento di
             default di FCM); ad app aperta venivano scartati senza lasciare traccia. -->
        <service
            android:name=".CircolareMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Condivisione di file generati in-app (es. il PDF della Mappa Posti) tramite share
             sheet, senza esporre l'intero filesystem dell'app: vedi res/xml/file_paths.xml e
             circolareplus.platform.SeatMapPdfExporter.android.kt. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Analisi di una circolare con l'AI sul telefono: tiene vivo il processo con una
             notifica e il tasto Stop mentre l'app e' in background (vedi
             circolareplus.work.AnalysisForegroundService). -->
        <service
            android:name="circolareplus.work.AnalysisForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- WorkManager: per Android 14+ (API 34) è obbligatorio dichiarare esplicitamente il
             tipo del servizio in primo piano se si usa setForeground() con un tipo specifico.
             LocalModelDownloadWorker usa FOREGROUND_SERVICE_TYPE_DATA_SYNC. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>
</manifest>
